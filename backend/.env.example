# Copy this file to backend/.env and set your key locally.
# The frontend never receives this value.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max
# low keeps interactive replies fast. none is the cheapest/fastest.
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2048

# Relative to the backend working directory.
DATABASE_PATH=data/operatesolve.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
