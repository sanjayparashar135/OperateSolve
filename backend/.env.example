# Copy this file to backend/.env and set your key locally.
# The frontend never receives this value.

OPENAI_API_KEY=
# Baseline model: used for Auto fallback. Must be a registered model id
# (gpt-6-luna, gpt-5-mini, gpt-5-nano). Pick per conversation in the chat UI.
OPENAI_MODEL=gpt-6-luna
# none | minimal | low | medium | high | xhigh | max
# low keeps interactive replies fast. A value a model does not accept is
# replaced per model (GPT-5 Mini/Nano have no "none"; they get "minimal").
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2048
# Turn models off without code changes: comma-separated keys or ids, e.g. mini,nano
DISABLED_MODELS=
# At startup, check which registered models this key can access (free, no tokens).
MODEL_ACCESS_CHECK=true

# Relative to the backend working directory.
DATABASE_PATH=data/operatesolve.db
# Browser traffic is same-origin via the Next.js /api proxy; CORS only matters for
# direct calls to :8000 (local tools / Postman). Do not use wildcards.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# When false, FastAPI /docs, /redoc, and /openapi.json are disabled.
EXPOSE_API_DOCS=true

LOG_LEVEL=INFO

# Per-model token rates (USD per 1M tokens) for the Usage dashboard estimates.
# Relative to the backend directory.
PRICING_CONFIG_PATH=pricing.json

# Phase 2.4 — context budgeting (conservative vs full model context windows).
CONTEXT_MAX_INPUT_TOKENS=24000
CONTEXT_TOKEN_SAFETY_MARGIN=1.15
CONTEXT_REASONING_RESERVE_TOKENS=1024

# Phase 2.4 — conversation summarization (separate low-cost model call).
SUMMARIZATION_ENABLED=true
SUMMARIZATION_MODEL=gpt-6-luna
SUMMARIZATION_MAX_OUTPUT_TOKENS=400
SUMMARIZATION_REASONING_EFFORT=low
SUMMARIZATION_TRIGGER_EXCLUDED_TOKENS=800
SUMMARIZATION_SUMMARY_BUDGET_TOKENS=500

# Phase 2.5B — sequential vs parallel LLM experiment (learning only; billed calls).
PARALLEL_EXPERIMENT_TIMEOUT_SECONDS=60
PARALLEL_EXPERIMENT_MAX_CONCURRENCY=3
PARALLEL_EXPERIMENT_MAX_OUTPUT_TOKENS=400

# Phase 3.1 — RAG foundation (embeddings + local ChromaDB).
KNOWLEDGE_SOURCE_DIR=data/knowledge/source
CHROMA_PERSIST_DIRECTORY=data/knowledge/chroma
CHROMA_COLLECTION_NAME=operatesolve_knowledge
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
RAG_CHUNK_SIZE_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=75

# Phase 3.2 — grounded RAG answers (one structured LLM call per question).
# Leave RAG_ANSWER_MODEL blank to use OPENAI_MODEL. Must support structured_outputs.
RAG_ANSWER_MODEL=
RAG_ANSWER_MAX_OUTPUT_TOKENS=1200
RAG_ANSWER_REASONING_EFFORT=low
RAG_ANSWER_TIMEOUT_SECONDS=60
RAG_CONTEXT_TOKEN_BUDGET=3500
# Cosine similarity floor before generation; 0 disables. Tune only after eval.
RAG_MIN_SIMILARITY=0

# Phase 3.3 — hybrid retrieval (semantic + BM25 + RRF) and optional local rerank.
# Keep semantic as default until hybrid is measured better on the eval set.
RAG_RETRIEVAL_MODE=semantic
RAG_SEMANTIC_CANDIDATES=20
RAG_BM25_CANDIDATES=20
RAG_RRF_K=60
RAG_RERANKER_ENABLED=false
# lexical_overlap = free local Jaccard reranker (query-dependent; measure before enabling)
RAG_RERANKER=lexical_overlap
BM25_INDEX_PATH=data/knowledge/bm25/index.json
