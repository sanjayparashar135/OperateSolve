# Server-only. Browser never sees these values.
# Local FastAPI origin used by Next.js rewrites and the streaming chat proxy.
BACKEND_URL=http://127.0.0.1:8000

# Optional: extra hostname-only origins for `next dev` (comma-separated, no scheme/port).
# `*.trycloudflare.com` is already allowed by default for Cloudflare Quick Tunnels.
# Example for a named tunnel hostname: ALLOWED_DEV_ORIGINS=demo.example.com
# ALLOWED_DEV_ORIGINS=
